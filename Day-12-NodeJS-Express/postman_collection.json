{
  "info": {
    "name": "Day 12 - Employee Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "ApexLark FSD Internship Day 12 - Node.js & Express.js"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    }
  ],
  "item": [
    {
      "name": "Welcome (GET /)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": []
        }
      }
    },
    {
      "name": "Get all employees",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/employees",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "employees"
          ]
        }
      }
    },
    {
      "name": "Get employee by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/employees/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "employees",
            "1"
          ]
        }
      }
    },
    {
      "name": "Create employee",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/employees",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "employees"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Neha Singh\",\n  \"email\": \"neha.singh@example.com\",\n  \"department\": \"Quality Assurance\",\n  \"position\": \"QA Engineer\",\n  \"salary\": 600000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Update employee",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/employees/4",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "employees",
            "4"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"position\": \"Senior QA Engineer\",\n  \"salary\": 750000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Delete employee",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/employees/4",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "employees",
            "4"
          ]
        }
      }
    },
    {
      "name": "Error cases",
      "item": [
        {
          "name": "Get non-existent employee (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/employees/99",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "employees",
                "99"
              ]
            }
          }
        },
        {
          "name": "Invalid ID (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/employees/abc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "employees",
                "abc"
              ]
            }
          }
        },
        {
          "name": "Create with invalid data (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/employees",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "employees"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"email\": \"not-an-email\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Create duplicate email (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/employees",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "employees"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Neha Singh\",\n  \"email\": \"aarav.sharma@example.com\",\n  \"department\": \"Quality Assurance\",\n  \"position\": \"QA Engineer\",\n  \"salary\": 600000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Unknown route (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/unknown",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "unknown"
              ]
            }
          }
        }
      ]
    }
  ]
}